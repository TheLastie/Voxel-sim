// Validated solver settings with a moderate axe strike for visible impact.
(
    dimensions: (12, 12, 30),
    branch_dimensions: (0, 0, 0),
    ground_dimensions: (80, 80, 1),
    tool_dimensions: (20, 5, 14),
    fibers: (0.0, 0.0, 1.0),
    anisotropy: 1.0,
    gravity: (0.0, 0.0, -9.81),
    atmosphere: (
        pressure_pa: 101325.0,
        temperature_kelvin: 293.15,
        wind_velocity_m_s: (0.0, 0.0, 0.0),
        drag_coefficient: 0.65,
    ),
    fixed_dt: 0.01,
    substeps: 40,
    iterations: 80,
    cuda_iterations: 640,
    solver_relative_tolerance: 0.00001,
    corotation_tolerance: 0.00001,
    corotation_iterations: 2,
    fracture: (
        damage_rate: 35.0,
        energy_release: 0.005,
        propagation_delay: 1,
        fatigue_cycles: 1000.0,
        fatigue_exponent: 3.0,
        fatigue_threshold: 0.5,
        plastic_heat_fraction: 0.9,
        fragment_min_size: 10,
        cluster_interval: 10,
        friction: 0.35,
        restitution: 0.1,
    ),
    initial_speed: 0.0,
    tool_start: (-0.25, 0.0, 0.15),
    tool_direction: (1.0, 0.0, 0.0),
)
