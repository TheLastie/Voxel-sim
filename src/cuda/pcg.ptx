.version 7.0
.target sm_75
.address_size 64
.visible .entry block_sparse_matvec(
    .param .u64 diagonal_ptr,
    .param .u64 x_ptr,
    .param .u64 neighbors_ptr,
    .param .u64 blocks_ptr,
    .param .u64 y_ptr,
    .param .u32 count
) {
    .reg .pred %p<4>;
    .reg .b32 %r<12>;
    .reg .b64 %rd<16>;
    .reg .f32 %f<32>;
    ld.param.u64 %rd1, [diagonal_ptr];
    ld.param.u64 %rd2, [x_ptr];
    ld.param.u64 %rd3, [neighbors_ptr];
    ld.param.u64 %rd4, [blocks_ptr];
    ld.param.u64 %rd5, [y_ptr];
    ld.param.u32 %r8, [count];
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r3, %tid.x;
    mad.lo.u32 %r4, %r1, %r2, %r3;
    setp.ge.u32 %p1, %r4, %r8;
    @%p1 bra DONE;

    mul.wide.u32 %rd8, %r4, 12;
    add.u64 %rd9, %rd2, %rd8;
    ld.global.f32 %f2, [%rd9];
    ld.global.f32 %f3, [%rd9+4];
    ld.global.f32 %f4, [%rd9+8];
    mul.wide.u32 %rd6, %r4, 36;
    add.u64 %rd7, %rd1, %rd6;
    ld.global.f32 %f5, [%rd7];
    ld.global.f32 %f6, [%rd7+4];
    ld.global.f32 %f7, [%rd7+8];
    ld.global.f32 %f8, [%rd7+12];
    ld.global.f32 %f9, [%rd7+16];
    ld.global.f32 %f10, [%rd7+20];
    ld.global.f32 %f11, [%rd7+24];
    ld.global.f32 %f12, [%rd7+28];
    ld.global.f32 %f13, [%rd7+32];
    mul.f32 %f26, %f5, %f2;
    fma.rn.f32 %f26, %f6, %f3, %f26;
    fma.rn.f32 %f26, %f7, %f4, %f26;
    mul.f32 %f27, %f8, %f2;
    fma.rn.f32 %f27, %f9, %f3, %f27;
    fma.rn.f32 %f27, %f10, %f4, %f27;
    mul.f32 %f28, %f11, %f2;
    fma.rn.f32 %f28, %f12, %f3, %f28;
    fma.rn.f32 %f28, %f13, %f4, %f28;

    mul.lo.u32 %r5, %r4, 6;
    mov.u32 %r6, 0;
LOOP:
    add.u32 %r7, %r5, %r6;
    mul.wide.u32 %rd10, %r7, 4;
    add.u64 %rd11, %rd3, %rd10;
    ld.global.u32 %r9, [%rd11];
    setp.eq.u32 %p2, %r9, 0xffffffff;
    @%p2 bra NEXT;
    mul.wide.u32 %rd12, %r9, 12;
    add.u64 %rd13, %rd2, %rd12;
    ld.global.f32 %f14, [%rd13];
    ld.global.f32 %f15, [%rd13+4];
    ld.global.f32 %f16, [%rd13+8];

    mul.lo.u32 %r10, %r7, 9;
    // Each packed 3x3 edge block contains 9 f32 values (36 bytes).
    mul.wide.u32 %rd14, %r10, 4;
    add.u64 %rd15, %rd4, %rd14;
    ld.global.f32 %f17, [%rd15];
    ld.global.f32 %f18, [%rd15+4];
    ld.global.f32 %f19, [%rd15+8];
    ld.global.f32 %f20, [%rd15+12];
    ld.global.f32 %f21, [%rd15+16];
    ld.global.f32 %f22, [%rd15+20];
    ld.global.f32 %f23, [%rd15+24];
    ld.global.f32 %f24, [%rd15+28];
    ld.global.f32 %f25, [%rd15+32];
    fma.rn.f32 %f26, %f17, %f14, %f26;
    fma.rn.f32 %f26, %f18, %f15, %f26;
    fma.rn.f32 %f26, %f19, %f16, %f26;
    fma.rn.f32 %f27, %f20, %f14, %f27;
    fma.rn.f32 %f27, %f21, %f15, %f27;
    fma.rn.f32 %f27, %f22, %f16, %f27;
    fma.rn.f32 %f28, %f23, %f14, %f28;
    fma.rn.f32 %f28, %f24, %f15, %f28;
    fma.rn.f32 %f28, %f25, %f16, %f28;
NEXT:
    add.u32 %r6, %r6, 1;
    setp.lt.u32 %p3, %r6, 6;
    @%p3 bra LOOP;

    add.u64 %rd6, %rd5, %rd8;
    st.global.f32 [%rd6], %f26;
    st.global.f32 [%rd6+4], %f27;
    st.global.f32 [%rd6+8], %f28;
DONE:
    ret;
}
.visible .entry block_jacobi(
    .param .u64 inverse_ptr,
    .param .u64 residual_ptr,
    .param .u64 output_ptr,
    .param .u32 count
) {
    .reg .pred %p<2>;
    .reg .b32 %r<5>;
    .reg .b64 %rd<7>;
    .reg .f32 %f<14>;
    ld.param.u64 %rd1, [inverse_ptr];
    ld.param.u64 %rd2, [residual_ptr];
    ld.param.u64 %rd3, [output_ptr];
    ld.param.u32 %r1, [count];
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mov.u32 %r4, %tid.x;
    mad.lo.u32 %r0, %r2, %r3, %r4;
    setp.ge.u32 %p1, %r0, %r1;
    @%p1 bra J_DONE;
    mul.wide.u32 %rd4, %r0, 12;
    add.u64 %rd5, %rd2, %rd4;
    ld.global.f32 %f1, [%rd5];
    ld.global.f32 %f2, [%rd5+4];
    ld.global.f32 %f3, [%rd5+8];
    mul.wide.u32 %rd6, %r0, 36;
    add.u64 %rd6, %rd1, %rd6;
    ld.global.f32 %f4, [%rd6];
    ld.global.f32 %f5, [%rd6+4];
    ld.global.f32 %f6, [%rd6+8];
    ld.global.f32 %f7, [%rd6+12];
    ld.global.f32 %f8, [%rd6+16];
    ld.global.f32 %f9, [%rd6+20];
    ld.global.f32 %f10, [%rd6+24];
    ld.global.f32 %f11, [%rd6+28];
    ld.global.f32 %f12, [%rd6+32];
    mul.f32 %f13, %f4, %f1;
    fma.rn.f32 %f13, %f5, %f2, %f13;
    fma.rn.f32 %f13, %f6, %f3, %f13;
    mul.f32 %f4, %f7, %f1;
    fma.rn.f32 %f4, %f8, %f2, %f4;
    fma.rn.f32 %f4, %f9, %f3, %f4;
    mul.f32 %f5, %f10, %f1;
    fma.rn.f32 %f5, %f11, %f2, %f5;
    fma.rn.f32 %f5, %f12, %f3, %f5;
    add.u64 %rd5, %rd3, %rd4;
    st.global.f32 [%rd5], %f13;
    st.global.f32 [%rd5+4], %f4;
    st.global.f32 [%rd5+8], %f5;
J_DONE:
    ret;
}
.visible .entry pcg_update(
    .param .u64 dx_ptr,
    .param .u64 r_ptr,
    .param .u64 p_ptr,
    .param .u64 ap_ptr,
    .param .u64 alpha_ptr,
    .param .u32 count
) {
    .reg .pred %p<2>;
    .reg .b32 %r<7>;
    .reg .b64 %rd<10>;
    .reg .f32 %f<6>;
    ld.param.u64 %rd1, [dx_ptr];
    ld.param.u64 %rd2, [r_ptr];
    ld.param.u64 %rd3, [p_ptr];
    ld.param.u64 %rd4, [ap_ptr];
    ld.param.u64 %rd9, [alpha_ptr];
    ld.global.f32 %f1, [%rd9];
    ld.param.u32 %r1, [count];
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mov.u32 %r4, %tid.x;
    mad.lo.u32 %r5, %r2, %r3, %r4;
    mul.lo.u32 %r1, %r1, 3;
    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra U_DONE;
    mul.wide.u32 %rd8, %r5, 4;
    add.u64 %rd6, %rd1, %rd8;
    add.u64 %rd7, %rd2, %rd8;
    add.u64 %rd5, %rd3, %rd8;
    add.u64 %rd8, %rd4, %rd8;
    ld.global.f32 %f2, [%rd6];
    ld.global.f32 %f3, [%rd5];
    ld.global.f32 %f4, [%rd8];
    ld.global.f32 %f5, [%rd7];
    fma.rn.f32 %f2, %f1, %f3, %f2;
    neg.f32 %f1, %f1;
    fma.rn.f32 %f5, %f1, %f4, %f5;
    st.global.f32 [%rd6], %f2;
    st.global.f32 [%rd7], %f5;
U_DONE:
    ret;
}
.visible .entry pcg_update_direction(
    .param .u64 p_ptr,
    .param .u64 z_ptr,
    .param .u64 beta_ptr,
    .param .u32 count
) {
    .reg .pred %p<2>;
    .reg .b32 %r<6>;
    .reg .b64 %rd<6>;
    .reg .f32 %f<4>;
    ld.param.u64 %rd1, [p_ptr];
    ld.param.u64 %rd2, [z_ptr];
    ld.param.u64 %rd5, [beta_ptr];
    ld.global.f32 %f1, [%rd5];
    ld.param.u32 %r1, [count];
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mov.u32 %r4, %tid.x;
    mad.lo.u32 %r5, %r2, %r3, %r4;
    mul.lo.u32 %r1, %r1, 3;
    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra D_DONE;
    mul.wide.u32 %rd3, %r5, 4;
    add.u64 %rd4, %rd1, %rd3;
    add.u64 %rd3, %rd2, %rd3;
    ld.global.f32 %f2, [%rd4];
    ld.global.f32 %f3, [%rd3];
    fma.rn.f32 %f2, %f1, %f2, %f3;
    st.global.f32 [%rd4], %f2;
D_DONE:
    ret;
}
.visible .entry dot_product(
    .param .u64 left_ptr,
    .param .u64 right_ptr,
    .param .u64 output_ptr,
    .param .u32 count
) {
    .reg .pred %p<2>;
    .reg .b32 %r<10>;
    .reg .b64 %rd<10>;
    .reg .f32 %f<7>;
    .reg .f64 %fd<4>;
    .shared .align 8 .b8 dot_shared[2048];
    ld.param.u64 %rd1, [left_ptr];
    ld.param.u64 %rd2, [right_ptr];
    ld.param.u64 %rd3, [output_ptr];
    ld.param.u32 %r1, [count];
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mov.u32 %r4, %tid.x;
    mad.lo.u32 %r5, %r2, %r3, %r4;
    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra DOT_ZERO;
    mul.wide.u32 %rd4, %r5, 12;
    add.u64 %rd5, %rd1, %rd4;
    add.u64 %rd4, %rd2, %rd4;
    ld.global.f32 %f1, [%rd5];
    ld.global.f32 %f2, [%rd4];
    ld.global.f32 %f3, [%rd5+4];
    ld.global.f32 %f4, [%rd4+4];
    ld.global.f32 %f5, [%rd5+8];
    ld.global.f32 %f6, [%rd4+8];
    cvt.f64.f32 %fd1, %f1;
    cvt.f64.f32 %fd2, %f2;
    mul.f64 %fd3, %fd1, %fd2;
    cvt.f64.f32 %fd1, %f3;
    cvt.f64.f32 %fd2, %f4;
    fma.rn.f64 %fd3, %fd1, %fd2, %fd3;
    cvt.f64.f32 %fd1, %f5;
    cvt.f64.f32 %fd2, %f6;
    fma.rn.f64 %fd3, %fd1, %fd2, %fd3;
    mul.wide.u32 %rd6, %r5, 8;
    bra DOT_STORE;
DOT_ZERO:
    mov.f64 %fd3, 0d0000000000000000;
DOT_STORE:
    mul.wide.u32 %rd8, %r4, 8;
    mov.u64 %rd9, dot_shared;
    add.u64 %rd9, %rd9, %rd8;
    st.shared.f64 [%rd9], %fd3;
    bar.sync 0;
    mov.u32 %r6, 128;
DOT_REDUCE:
    setp.ge.u32 %p1, %r4, %r6;
    @%p1 bra DOT_SKIP_ADD;
    mul.wide.u32 %rd8, %r4, 8;
    mov.u64 %rd9, dot_shared;
    add.u64 %rd9, %rd9, %rd8;
    mul.wide.u32 %rd7, %r6, 8;
    add.u64 %rd7, %rd7, %rd9;
    ld.shared.f64 %fd1, [%rd9];
    ld.shared.f64 %fd2, [%rd7];
    add.f64 %fd3, %fd1, %fd2;
    st.shared.f64 [%rd9], %fd3;
DOT_SKIP_ADD:
    bar.sync 0;
    shr.u32 %r6, %r6, 1;
    setp.ne.u32 %p1, %r6, 0;
    @%p1 bra DOT_REDUCE;
    setp.ne.u32 %p1, %r4, 0;
    @%p1 bra DOT_DONE;
    mov.u64 %rd9, dot_shared;
    ld.shared.f64 %fd3, [%rd9];
    mul.wide.u32 %rd8, %r2, 8;
    add.u64 %rd9, %rd3, %rd8;
    st.global.f64 [%rd9], %fd3;
DOT_DONE:
    ret;
}
.visible .entry dot_reduce(
    .param .u64 partial_ptr,
    .param .u64 output_ptr,
    .param .u32 count
) {
    .reg .pred %p<3>;
    .reg .b32 %r<10>;
    .reg .b64 %rd<10>;
    .reg .f64 %fd<5>;
    .shared .align 8 .b8 reduce_shared[2048];
    ld.param.u64 %rd1, [partial_ptr];
    ld.param.u64 %rd2, [output_ptr];
    ld.param.u32 %r1, [count];
    mov.u32 %r2, %tid.x;
    // Each lane starts at its own partial; starting every lane at zero
    // multiplies the final reduction by the block width (256).
    mov.u32 %r3, %r2;
    mov.f64 %fd1, 0d0000000000000000;
REDUCE_LOAD:
    setp.ge.u32 %p1, %r3, %r1;
    @%p1 bra REDUCE_STORE;
    mul.wide.u32 %rd3, %r3, 8;
    add.u64 %rd4, %rd1, %rd3;
    ld.global.f64 %fd2, [%rd4];
    add.f64 %fd1, %fd1, %fd2;
    add.u32 %r3, %r3, 256;
    bra REDUCE_LOAD;
REDUCE_STORE:
    mul.wide.u32 %rd3, %r2, 8;
    mov.u64 %rd4, reduce_shared;
    add.u64 %rd4, %rd4, %rd3;
    st.shared.f64 [%rd4], %fd1;
    bar.sync 0;
    mov.u32 %r4, 128;
REDUCE_TREE:
    setp.ge.u32 %p2, %r2, %r4;
    @%p2 bra REDUCE_SKIP_ADD;
    mul.wide.u32 %rd3, %r2, 8;
    mov.u64 %rd4, reduce_shared;
    add.u64 %rd4, %rd4, %rd3;
    mul.wide.u32 %rd5, %r4, 8;
    add.u64 %rd5, %rd5, %rd4;
    ld.shared.f64 %fd2, [%rd4];
    ld.shared.f64 %fd3, [%rd5];
    add.f64 %fd2, %fd2, %fd3;
    st.shared.f64 [%rd4], %fd2;
REDUCE_SKIP_ADD:
    bar.sync 0;
    shr.u32 %r4, %r4, 1;
    setp.ne.u32 %p2, %r4, 0;
    @%p2 bra REDUCE_TREE;
    setp.ne.u32 %p2, %r2, 0;
    @%p2 bra REDUCE_DONE;
    mov.u64 %rd4, reduce_shared;
    ld.shared.f64 %fd1, [%rd4];
    st.global.f64 [%rd2], %fd1;
REDUCE_DONE:
    ret;
}
.visible .entry dot_reduce_ratio(
    .param .u64 partial_ptr,
    .param .u64 numerator_ptr,
    .param .u64 output_ptr,
    .param .u32 count
) {
    .reg .pred %p<4>;
    .reg .b32 %r<10>;
    .reg .b64 %rd<12>;
    .reg .f32 %f<2>;
    .reg .f64 %fd<6>;
    .shared .align 8 .b8 reduce_shared[2048];
    ld.param.u64 %rd1, [partial_ptr];
    ld.param.u64 %rd2, [numerator_ptr];
    ld.param.u64 %rd3, [output_ptr];
    ld.param.u32 %r1, [count];
    mov.u32 %r2, %tid.x;
    mov.u32 %r3, %r2;
    mov.f64 %fd1, 0d0000000000000000;
RATIO_REDUCE_LOAD:
    setp.ge.u32 %p1, %r3, %r1;
    @%p1 bra RATIO_REDUCE_STORE;
    mul.wide.u32 %rd4, %r3, 8;
    add.u64 %rd5, %rd1, %rd4;
    ld.global.f64 %fd2, [%rd5];
    add.f64 %fd1, %fd1, %fd2;
    add.u32 %r3, %r3, 256;
    bra RATIO_REDUCE_LOAD;
RATIO_REDUCE_STORE:
    mul.wide.u32 %rd4, %r2, 8;
    mov.u64 %rd5, reduce_shared;
    add.u64 %rd5, %rd5, %rd4;
    st.shared.f64 [%rd5], %fd1;
    bar.sync 0;
    mov.u32 %r4, 128;
RATIO_REDUCE_TREE:
    setp.ge.u32 %p2, %r2, %r4;
    @%p2 bra RATIO_REDUCE_SKIP_ADD;
    mul.wide.u32 %rd4, %r2, 8;
    mov.u64 %rd5, reduce_shared;
    add.u64 %rd5, %rd5, %rd4;
    mul.wide.u32 %rd6, %r4, 8;
    add.u64 %rd6, %rd5, %rd6;
    ld.shared.f64 %fd2, [%rd5];
    ld.shared.f64 %fd3, [%rd6];
    add.f64 %fd2, %fd2, %fd3;
    st.shared.f64 [%rd5], %fd2;
RATIO_REDUCE_SKIP_ADD:
    bar.sync 0;
    shr.u32 %r4, %r4, 1;
    setp.ne.u32 %p2, %r4, 0;
    @%p2 bra RATIO_REDUCE_TREE;
    setp.ne.u32 %p2, %r2, 0;
    @%p2 bra RATIO_REDUCE_DONE;
    mov.u64 %rd5, reduce_shared;
    ld.shared.f64 %fd1, [%rd5];
    ld.global.f64 %fd2, [%rd2];
    setp.gt.f64 %p3, %fd1, 1.0e-30;
    @!%p3 bra RATIO_REDUCE_ZERO;
    div.rn.f64 %fd3, %fd2, %fd1;
    cvt.rn.f32.f64 %f1, %fd3;
    bra RATIO_REDUCE_OUTPUT;
RATIO_REDUCE_ZERO:
    mov.f32 %f1, 0f00000000;
RATIO_REDUCE_OUTPUT:
    st.global.f32 [%rd3], %f1;
RATIO_REDUCE_DONE:
    ret;
}
.visible .entry scalar_ratio(
    .param .u64 numerator_ptr,
    .param .u64 denominator_ptr,
    .param .u64 output_ptr
) {
    .reg .pred %p<3>;
    .reg .b32 %r<2>;
    .reg .b64 %rd<5>;
    .reg .f32 %f<2>;
    .reg .f64 %fd<4>;
    ld.param.u64 %rd1, [numerator_ptr];
    ld.param.u64 %rd2, [denominator_ptr];
    ld.param.u64 %rd3, [output_ptr];
    mov.u32 %r1, %tid.x;
    setp.ne.u32 %p2, %r1, 0;
    @%p2 bra RATIO_DONE;
    ld.global.f64 %fd1, [%rd1];
    ld.global.f64 %fd2, [%rd2];
    setp.gt.f64 %p1, %fd2, 1.0e-30;
    @!%p1 bra RATIO_ZERO;
    div.rn.f64 %fd3, %fd1, %fd2;
    cvt.rn.f32.f64 %f1, %fd3;
    bra RATIO_STORE;
RATIO_ZERO:
    mov.f32 %f1, 0f00000000;
RATIO_STORE:
    st.global.f32 [%rd3], %f1;
RATIO_DONE:
    ret;
}

.visible .entry pcg_update_precondition(
    .param .u64 inverse_ptr,
    .param .u64 dx_ptr,
    .param .u64 r_ptr,
    .param .u64 p_ptr,
    .param .u64 ap_ptr,
    .param .u64 alpha_ptr,
    .param .u64 z_ptr,
    .param .u32 count
) {
    .reg .pred %p<2>;
    .reg .b32 %r<8>;
    .reg .b64 %rd<12>;
    .reg .f32 %f<20>;
    ld.param.u64 %rd1, [inverse_ptr];
    ld.param.u64 %rd2, [dx_ptr];
    ld.param.u64 %rd3, [r_ptr];
    ld.param.u64 %rd4, [p_ptr];
    ld.param.u64 %rd5, [ap_ptr];
    ld.param.u64 %rd6, [alpha_ptr];
    ld.param.u64 %rd7, [z_ptr];
    ld.param.u32 %r1, [count];
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mov.u32 %r4, %tid.x;
    mad.lo.u32 %r5, %r2, %r3, %r4;
    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra UP_DONE;

    ld.global.f32 %f1, [%rd6];
    mul.wide.u32 %rd8, %r5, 12;
    add.u64 %rd9, %rd2, %rd8;
    add.u64 %rd10, %rd3, %rd8;
    add.u64 %rd11, %rd4, %rd8;
    add.u64 %rd8, %rd5, %rd8;
    ld.global.f32 %f2, [%rd9];
    ld.global.f32 %f3, [%rd9+4];
    ld.global.f32 %f4, [%rd9+8];
    ld.global.f32 %f5, [%rd10];
    ld.global.f32 %f6, [%rd10+4];
    ld.global.f32 %f7, [%rd10+8];
    ld.global.f32 %f8, [%rd11];
